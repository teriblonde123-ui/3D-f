import numpy as np
from stl import mesh

def create_block(min_pt, max_pt):
    x0, y0, z0 = min_pt
    x1, y1, z1 = max_pt
    vertices = np.array([
        [x0, y0, z0], [x1, y0, z0], [x1, y1, z0], [x0, y1, z0],
        [x0, y0, z1], [x1, y0, z1], [x1, y1, z1], [x0, y1, z1]
    ])
    faces = np.array([
        [0, 3, 1], [1, 3, 2], [0, 4, 7], [0, 7, 3],
        [4, 5, 6], [4, 6, 7], [5, 1, 2], [5, 2, 6],
        [2, 3, 7], [2, 7, 6], [0, 1, 5], [0, 5, 4]
    ])
    return vertices, faces

# Base Body Block
v1, f1 = create_block([-30, -45, 0], [30, 45, 25])
# Left Click Button Block
v2, f2 = create_block([-28, -42, 25], [-2, -10, 30])
# Right Click Button Block
v3, f3 = create_block([2, -42, 25], [28, -10, 30])
# Scroll Bar Housing
v4, f4 = create_block([-4, -40, 25], [4, -10, 28])
# Thumb Rest Wing Block
v5, f5 = create_block([-42, -20, 0], [-30, 30, 10])

# Combine all shapes into a single 3D Mesh
all_vertices = np.vstack([v1, v2, v3, v4, v5])
f2 += len(v1)
f3 += len(v1) + len(v2)
f4 += len(v1) + len(v2) + len(v3)
f5 += len(v1) + len(v2) + len(v3) + len(v4)
all_faces = np.vstack([f1, f2, f3, f4, f5])

mouse_mesh = mesh.Mesh(np.zeros(all_faces.shape[0], dtype=mesh.Mesh.dtype))
for i, f in enumerate(all_faces):
    for j in range(3):
        mouse_mesh.vectors[i][j] = all_vertices[f[j]]

# Export directly to 3D STL file
mouse_mesh.save('custom_ergonomic_mouse.stl')
print("File successfully generated: custom_ergonomic_mouse.stl")
